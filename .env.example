# Personal AI 工作台环境变量示例
# 复制为 .env 后按实际部署修改；.env 已被 gitignore，权限建议 600。
# 真实环境变量优先于 .env，不会被文件覆盖。

# ---------- 基础 ----------
# 账号数据库、会话密钥、限流状态的目录；不改变媒体目录。
# PERSONAL_AI_STATE_DIR=/var/lib/personal-ai
# 生产环境建议由外部秘密管理提供；留空则自动生成 data/.session-secret。
# PERSONAL_AI_SECRET_KEY=
# HTTPS 部署必须设为 1，否则登录 Cookie 不会带 Secure。
PERSONAL_AI_COOKIE_SECURE=0
# 可选：共享限流后端；单进程可留空。
# PERSONAL_AI_RATELIMIT_STORAGE_URI=
# 管理员批准的工作流服务完整地址，逗号分隔。
# PERSONAL_AI_WORKFLOW_BASE_URLS=

# ---------- 本地媒体目录 ----------
# 视频片库根目录（会递归扫描 mp4/mov/mkv/avi）。
MOVIES_DIR=~/Movies
# 番号下载保存目录；每个番号一个子目录。
NYAA_DIR=~/Movies/Videos
# 本地写真集根目录（下载的写真、回收站都在这里）。
LOCAL_PHOTO_DIR=~/Movies/写真
# 视频封面定时刷新间隔（秒），最小 3600。
VIDEO_COVER_REFRESH_SECONDS=86400

# ---------- 网络代理 ----------
# 番号搜索、JavDatabase、av-wiki、theidolbase/theactorbase、NDL 等使用。
NYAA_PROXY=http://127.0.0.1:7897
# DMM/FANZA 日本出口；DMM 封面、书籍、JavDatabase 等使用。
DMM_PROXY=http://127.0.0.1:7898
# 可替换的站点根地址（站点迁移时修改）。
NYAA_BASE=https://sukebei.nyaa.si
JAVDB_BASE=https://javdb.com

# ---------- 迅雷 / 下载器 ----------
# 0 = 只保存 .torrent，不调用下载器；Linux/无迅雷环境建议设为 0。
THUNDER_ENABLED=1
# macOS 的迅雷应用名。
THUNDER_APP=Thunder
# 跨平台启动命令；路径会作为最后一个参数追加。
# Linux 示例：THUNDER_CMD=transmission-gtk
# THUNDER_CMD=

# ---------- AI 服务 ----------
AUTODL_ART_TOKEN=
AZT_API_KEY=
COMFY_URL=
IMAGE_GENERATION_BACKEND=comfy
LOCAL_IMAGE_API_URL=
LOCAL_IMAGE_API_KEY=
LOCAL_IMAGE_MODEL=
SEETACLOUD_IMAGE_URL=
SEETACLOUD_IMAGE_API_KEY=
SEETACLOUD_IMAGE_STEPS=
SEETACLOUD_IMAGE_TRUE_CFG_SCALE=
SEETACLOUD_IMAGE_TIMEOUT=
QWEN_API_URL=
QWEN_MODEL=
PHOTO_LAB_URL=http://127.0.0.1:4174
